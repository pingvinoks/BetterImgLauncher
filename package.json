{
  "name": "betterimglauncher",
  "version": "1.0.2",
  "description": "Better Image Modpack Launcher",
  "author": {
    "name": "krutoichervak22",
    "email": "a71613390@gmail.com"
  },
  "homepage": "https://github.com/YOUR_USERNAME/betterimglauncher",
  "license": "Unlicense",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "build": "npm run build:mac && npm run build:linux && npm run build:win",
    "build:mac": "electron-builder --mac --universal",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:clean": "rm -rf dist && npm run build"
  },
  "build": {
    "appId": "com.betterimg.launcher",
    "productName": "BetterImgLauncher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.games"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "minecraft-launcher-core": "^3.18.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.18.0"
  }
}